{
  "name": "twototango",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/bank"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -b && npm run check -w @twototango/client",
    "build": "npm run build -w @twototango/client",
    "dev": "VITE_DEV_BANK=1 npm run build && node apps/devhost/src/main.ts",
    "e2e": "VITE_DEV_BANK=1 npm run build && playwright test",
    "bank": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node tools/bank/src/cli.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
